<?xml version='1.0' encoding='utf-8'?>
<interface version="1.5" author="PygubuDesigner 0.41.4">
  <project>
    <settings>
      <setting id="name">Label Test</setting>
      <setting id="description">Test Label code generation</setting>
      <setting id="module_name">create_label</setting>
      <setting id="template">fnscript</setting>
      <setting id="main_widget">label1</setting>
      <setting id="main_classname">create_label</setting>
      <setting id="output_dir">../gcode</setting>
      <setting id="output_dir2" />
      <setting id="import_tkvariables">False</setting>
      <setting id="use_ttk_styledefinition_file">False</setting>
      <setting id="use_i18n">False</setting>
      <setting id="all_ids_attributes">False</setting>
      <setting id="generate_code_onsave">False</setting>
      <setting id="use_window_centering_code">False</setting>
      <setting id="ttk_style_definition_file" />
    </settings>
    <customwidgets />
    <resources />
  </project>
  <object class="ttkbootstrap.frame" id="frame1">
    <property name="height">200</property>
    <property name="width">200</property>
    <layout manager="pack">
      <property name="side">top</property>
    </layout>
    <containerlayout manager="pack">
      <property name="propagate">false</property>
    </containerlayout>
    <child>
      <object class="ttkbootstrap.label" id="label1">
        <property name="anchor">center</property>
        <property name="compound">left</property>
        <property name="icon">gear</property>
        <property name="text" translatable="yes">label1</property>
        <layout manager="pack">
          <property name="expand">true</property>
          <property name="ipadx">20</property>
          <property name="ipady">20</property>
          <property name="side">top</property>
        </layout>
      </object>
    </child>
  </object>
</interface>
